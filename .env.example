# Copy to .env and fill in. .env is gitignored and excluded from the Docker
# build context - secrets are injected at runtime, never baked into the image.

# Required: web-search fallback
FIRECRAWL_API_KEY=

# LLM provider: groq (default) | ollama | openai
LLM_PROVIDER=groq

# groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ollama (docker compose overrides the base URL to http://ollama:11434)
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_BASE_URL=http://localhost:11434

# openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Vector store. Leave HONESTRAG_MILVUS_URI unset to use a local Milvus Lite file in
# HONESTRAG_DATA_DIR. For a hosted Milvus (e.g. Zilliz Cloud free tier) set the
# cluster's public endpoint and API key - uploads then survive app restarts
# even on hosts with no persistent disk.
# HONESTRAG_MILVUS_URI=https://in03-xxxxxxxx.serverless.gcp-us-west1.cloud.zilliz.com
# HONESTRAG_MILVUS_TOKEN=

# Where the local Milvus Lite file and the embedding-model cache live.
# Defaults to the project dir locally; the Docker image sets it to /data and
# ships the embedding model pre-downloaded (HONESTRAG_EMBED_CACHE_DIR/_OFFLINE).
# HONESTRAG_DATA_DIR=.
